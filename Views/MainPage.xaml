<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:TodoExplorer.Services"
    x:Class="TodoExplorer.Views.MainPage"
    x:Name="MainPageRef"
    BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Spacing="3">
            <Label Text="TodoExplorer"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#006C70"/>

            <Label Text="Keep track of your Todos"
                   FontSize="16"
                   TextColor="#666666"/>
                
                
            <Button Text="🔎 Filter"
                    Command="{Binding ToggleFilterCommand}"
                    BackgroundColor="White"
                    TextColor="#006C70"
                    BorderColor="#006C70"
                    BorderWidth="1"
                    CornerRadius="12"
                    HeightRequest="50"/>
            
            <!-- Filter button -->
            <Border IsVisible="{Binding IsVisible}"
                    BackgroundColor="White"
                    Stroke="#E0E0E0"
                    StrokeThickness="1"
                    Padding="15">
                

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Search Todos"
                           FontSize="18"
                           
                           FontAttributes="Bold"
                           TextColor="#333333"/>
                    
                    <Entry Text="{Binding SearchText}"
                           Placeholder="Search Todo text"
                           BackgroundColor="#F5F7FA"/>
                    
                    <Picker Title="Completion status"
                            TextColor="#006C70"
                            SelectedItem="{Binding CompletionFilter}">
                        <Picker.Items>
                            <x:String>All</x:String>
                            <x:String>Completed</x:String>
                            <x:String>Incomplete</x:String>
                        </Picker.Items>
                    </Picker>
                    
                    <Entry Text="{Binding UserIdFilter}"
                           Placeholder="User ID (optional)"
                           Keyboard="Numeric"
                           BackgroundColor="#F5F7FA"/>
                    <Button Text="Search"
                            Command="{Binding SearchCommand}"
                            BackgroundColor="#006C70"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"/>
                </VerticalStackLayout>

            </Border>
            <!-- Error message -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="14"/>
            <!-- Todo list title -->
            <Label Text="My Todos"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#333333"/>
            <!-- Todo list -->
            <CollectionView ItemsSource="{Binding Todos}"
                            SelectionChangedCommand="{Binding ShowDetailsCommand}"
                            SelectionChangedCommandParameter="{Binding SelectedItem, Source={RelativeSource Self}}" 
                            SelectionMode="Single">
    

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="White"
                                Stroke="#E5E5E5"
                                Padding="15">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <Button
                                    Text="Favorites"
                                    Command="{Binding BindingContext.FavNavNextCommand, Source={x:Reference MainPageRef}}" />
                                <Button Text="{Binding IsFavorite, Converter={converter:FavoriteConverter}}"
                                        Command="{Binding BindingContext.FavoriteCommand, Source={x:Reference MainPageRef}}"
                                        CommandParameter="{Binding .}"/>
                                <!-- Todo text -->
                                <Label Text="{Binding todo}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#006C70"/>

                                <!-- Completion status -->
                                <Label Text="{Binding completed, StringFormat='Completed: {0}'}"
                                       FontSize="14"
                                       TextColor="#555555"/>

                                <!-- User ID -->
                                <Label Text="{Binding userId, StringFormat='User ID: {0}'}"
                                       FontSize="14"
                                       TextColor="#777777"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

